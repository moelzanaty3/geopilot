{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "scope": "web", "release": false },
          { "scope": "docs", "release": false },
          { "scope": "ci", "release": false }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/npm", { "pkgRoot": "packages/geopilot" }],
    [
      "@semantic-release/exec",
      { "prepareCmd": "node scripts/build-plugins.mjs --version ${nextRelease.version}" }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["packages/geopilot/package.json", "plugins/**", ".claude-plugin/marketplace.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
