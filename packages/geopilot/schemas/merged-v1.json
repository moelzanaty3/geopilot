{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moelzanaty3.github.io/geopilot/schema/merged/v1.json",
  "title": "geo-merged/v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "geo-merged/v1"
    },
    "report": {
      "$ref": "https://moelzanaty3.github.io/geopilot/schema/report/v1.json"
    },
    "insights": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://moelzanaty3.github.io/geopilot/schema/insights/v1.json"
        }
      ]
    },
    "validation": {
      "type": [
        "object",
        "null"
      ]
    },
    "sections": {
      "type": "object",
      "properties": {
        "verifiedEngineFindings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agentRecommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hypothesesToValidate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "verifiedEngineFindings",
        "agentRecommendations",
        "hypothesesToValidate"
      ]
    },
    "disclaimer": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "report",
    "insights",
    "validation",
    "sections",
    "disclaimer"
  ]
}
